{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch2",
        "color": {
            "1": "green",
            "2": "blue"
        },
        "padding": {
            "top": 4,
            "left": 3
        }
    },

    "display": {
        "separator": " ",
        "bar": {
            "char": {
                "elapsed": "■",
                "total": "┄"
            },
            "width": 13
        },
        "percent": {
            "type": 2
        }
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "format": "\u001b[1;34m╭─ Hardware\u001b[0m"
        },
        {
            "type": "host",
            "key": "\u001b[34m├─   Host\u001b[0m",
            "keyColor": "blue",
            "keyWidth": 18
        },
        {
            "type": "kernel",
            "key": "\u001b[34m├─   Kernel\u001b[0m",
            "keyColor": "blue",
            "keyWidth": 18
        },
        {
            "type": "cpu",
            "key": "\u001b[34m├─ 󰻠  CPU\u001b[0m",
            "keyColor": "blue",
            "keyWidth": 18
        },
        {
            "type": "gpu",
            "key": "\u001b[34m├─ 󰢮  GPU\u001b[0m",
            "keyColor": "blue",
            "keyWidth": 18
        },
        {
            "type": "memory",
            "key": "\u001b[34m├─   Memory\u001b[0m",
            "keyColor": "blue",
            "keyWidth": 18
        },
        {
            "type": "disk",
            "key": "\u001b[34m╰─   Disk\u001b[0m",
            "folders": "/",
            "keyColor": "blue",
            "keyWidth": 18
        },
        
        "break",

        {
            "type": "custom",
            "format": "\u001b[1;32m╭─ Environment\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[32m├─   OS\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18
        },
        {
            "type": "wm",
            "key": "\u001b[32m├─   WM\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18
        },
        {
            "type": "terminal",
            "key": "\u001b[32m├─ 󰊠  Terminal\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18
        },
        {
            "type": "shell",
            "key": "\u001b[32m├─ 󰈺  Shell\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18
        },
        {
            "type": "packages",
            "key": "\u001b[32m├─ 󰏖  Packages\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18
        },
        {
            "type": "command",
            "key": "\u001b[32m╰─   OS Age\u001b[0m",
            "keyColor": "green",
            "keyWidth": 18,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(((current - birth_install) / 86400)); echo $days_difference days"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[1;33m╭─ Live Status\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "\u001b[33m├─   Uptime\u001b[0m",
            "keyColor": "yellow",
            "keyWidth": 18
        },
        {
            "type": "battery",
            "key": "\u001b[33m├─   Battery\u001b[0m",
            "keyColor": "yellow",
            "keyWidth": 18
        },
        {
            "type": "wifi",
            "key": "\u001b[33m├─   Wi-Fi\u001b[0m",
            "keyColor": "yellow",
            "keyWidth": 18,
            "format": "{4}"
        },
        {
            "type": "command",
            "key": "\u001b[33m╰─ 󰎆  Media\u001b[0m",
            "keyColor": "yellow",
            "keyWidth": 18,
            "text": "playerctl metadata --format '{{title}}' 2>/dev/null || echo 'none'"
        },

        "break",

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
