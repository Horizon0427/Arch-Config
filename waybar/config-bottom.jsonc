// -*- mode: jsonc -*-
{
    "position": "bottom",
    "layer": "top",
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "battery",
        "pulseaudio",
        "clock",
        "network",
        "backlight"
    ],
    "modules-center": [
        "power-profiles-daemon"
    ],
    "modules-right": [
        "custom/cava",
        "group/music",
        "custom/longshot",
        "tray",
        "custom/power"
    ],

    
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "custom/cava": {
        "tooltip": false,
        "format": "{}",
        "exec": "~/.config/waybar/scripts/cava.sh"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": "",
            "headset": "",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": ["", " ", " "]
        },
       "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/longshot": {
        "format": "{icon}",
        "format-icons": {
            "idle": "󰹑",
            "selecting": "󰆞",
            "recording": "🔴",
            "stitching": "󰑮"
        },
        "exec": "state=$(~/Python-projects/longshot_tool/longshot.sh status); echo \"{\\\"alt\\\": \\\"$state\\\", \\\"class\\\": \\\"$state\\\"}\"",
        "return-type": "json",
        "interval": 1, 
        "on-click": "if [ $(~/Python-projects/longshot_tool/longshot.sh status) = 'idle' ]; then ~/Python-projects/longshot_tool/longshot.sh start; else ~/Python-projects/longshot_tool/longshot.sh stop; fi &",
        "on-click-right": "~/Python-projects/longshot_tool/longshot.sh cancel &",
        "tooltip": true,
        "tooltip-format": "左键: 开始/结束长截图\n右键: 直接取消并丢弃"
    },

    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "custom/prev",
            "mpris",
            "custom/next"
        ]
    },

    "custom/prev": {
        "exec": "echo '󰒮'",
        "format": "{}",
        "exec-if": "playerctl --ignore-player=firefox,chromium status 2>/dev/null",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/next": {
        "exec": "echo '󰒭'",
        "format": "{}",
        "exec-if": "playerctl --ignore-player=firefox,chromium status 2>/dev/null",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": false
    },

    "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
        "default": "▶",
        "spotify": ""
    },
    "status-icons": {
        "paused": "▶"
    },
    "ignored-players": ["firefox", "chromium"]
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 3 -T 300 -B 300",
        "tooltip": false
    }
}
