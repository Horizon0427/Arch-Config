+std::string CAsyncResourceManager::fadeOutImagePath(const std::string& port) {
+    const char* const dir = std::getenv("HYPRLOCK_FADE_OUT_DIR");
+
+    if (!dir || !*dir || port.empty() || port == "." || port == ".." || port.contains('/'))
+        return {};
+
+    const auto      path = std::filesystem::path(dir) / (port + ".png");
+    std::error_code ec;
+    if (!std::filesystem::is_regular_file(path, ec))
+        return {};
+
+    return path.string();
+}
