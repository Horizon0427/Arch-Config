+void CHyprlock::signalPrelockRelease() {
+    const char* const fifoPath = std::getenv("HYPRLOCK_PRELOCK_RELEASE_FIFO");
+    if (!fifoPath || !*fifoPath)
+        return;
+
+    const int fd = open(fifoPath, O_WRONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        Log::logger->log(Log::WARN, "Failed to open the Prelock release FIFO");
+        return;
+    }
+
+    static constexpr char MESSAGE[] = "release\n";
+    const auto            written   = write(fd, MESSAGE, sizeof(MESSAGE) - 1);
+    if (written != static_cast<ssize_t>(sizeof(MESSAGE) - 1))
+        Log::logger->log(Log::WARN, "Failed to notify the Prelock launcher");
+    close(fd);
+}
