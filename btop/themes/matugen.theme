# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#111418"

# Main text color
theme[main_fg]="#e1e2e8"

# Title color for boxes
theme[title]="#a0cafd"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#bbc7db"

# Background color of selected items
theme[selected_bg]="#32353a"

# Foreground color of selected items
theme[selected_fg]="#a0cafd"

# Color of inactive/disabled text
theme[inactive_fg]="#8d9199"  

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c3c7cf"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#d6bee4"

# Box outline colors
theme[cpu_box]="#43474e"
theme[mem_box]="#43474e"
theme[net_box]="#43474e"
theme[proc_box]="#43474e"
theme[div_line]="#43474e"

# Temperature graph colors (Primary -> Tertiary -> Error)
theme[temp_start]="#a0cafd"
theme[temp_mid]="#d6bee4"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#a0cafd"
theme[cpu_mid]="#d6bee4"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter (Reversed: Error -> Tertiary -> Primary)
theme[free_start]="#ffb4ab"
theme[free_mid]="#d6bee4"
theme[free_end]="#a0cafd"

# Mem/Disk cached meter
theme[cached_start]="#bbc7db"
theme[cached_mid]="#3b4858"
theme[cached_end]="#a0cafd"

# Mem/Disk available meter
theme[available_start]="#ffb4ab"
theme[available_mid]="#d6bee4"
theme[available_end]="#a0cafd"

# Mem/Disk used meter
theme[used_start]="#a0cafd"
theme[used_mid]="#d6bee4"
theme[used_end]="#ffb4ab"

# Download graph colors
theme[download_start]="#a0cafd"
theme[download_mid]="#bbc7db"
theme[download_end]="#d6bee4"

# Upload graph colors
theme[upload_start]="#d6bee4"
theme[upload_mid]="#bbc7db"
theme[upload_end]="#a0cafd"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#a0cafd"
theme[process_mid]="#d6bee4"
theme[process_end]="#ffb4ab"
