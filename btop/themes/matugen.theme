# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#19120c"

# Main text color
theme[main_fg]="#efe0d5"

# Title color for boxes
theme[title]="#fdb975"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e1c1a4"

# Background color of selected items
theme[selected_bg]="#3c332c"

# Foreground color of selected items
theme[selected_fg]="#fdb975"

# Color of inactive/disabled text
theme[inactive_fg]="#9d8e81"  

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d5c3b5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c0cc9a"

# Box outline colors
theme[cpu_box]="#51453a"
theme[mem_box]="#51453a"
theme[net_box]="#51453a"
theme[proc_box]="#51453a"
theme[div_line]="#51453a"

# Temperature graph colors (Primary -> Tertiary -> Error)
theme[temp_start]="#fdb975"
theme[temp_mid]="#c0cc9a"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#fdb975"
theme[cpu_mid]="#c0cc9a"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter (Reversed: Error -> Tertiary -> Primary)
theme[free_start]="#ffb4ab"
theme[free_mid]="#c0cc9a"
theme[free_end]="#fdb975"

# Mem/Disk cached meter
theme[cached_start]="#e1c1a4"
theme[cached_mid]="#59422c"
theme[cached_end]="#fdb975"

# Mem/Disk available meter
theme[available_start]="#ffb4ab"
theme[available_mid]="#c0cc9a"
theme[available_end]="#fdb975"

# Mem/Disk used meter
theme[used_start]="#fdb975"
theme[used_mid]="#c0cc9a"
theme[used_end]="#ffb4ab"

# Download graph colors
theme[download_start]="#fdb975"
theme[download_mid]="#e1c1a4"
theme[download_end]="#c0cc9a"

# Upload graph colors
theme[upload_start]="#c0cc9a"
theme[upload_mid]="#e1c1a4"
theme[upload_end]="#fdb975"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#fdb975"
theme[process_mid]="#c0cc9a"
theme[process_end]="#ffb4ab"
